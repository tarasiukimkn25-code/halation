<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="EndScreen" src="project://database/Assets/EndScreen.uxml?fileID=9197481963319205126&amp;guid=f2d9d1defaa6ab14dabb7bcb037842f7&amp;type=3#EndScreen"/>
    <ui:Template name="NPCDialogue" src="project://database/Assets/NPCDialogue.uxml?fileID=9197481963319205126&amp;guid=7bb97cb0fe983974a9de29e223f7eb06&amp;type=3#NPCDialogue"/>
    <ui:Instance template="NPCDialogue" name="NPCDialogue" style="position: absolute; top: 0; right: 0; left: 0; bottom: 0;"/>
    <ui:Instance template="EndScreen" name="EndScreen" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;"/>
    <ui:Button name="MoonEncyclopediaButton" text="ДОСЛІДЖЕННЯ  0/5" focusable="false" style="position: absolute; top: 16px; right: 16px; width: 294px; height: 58px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(25, 35, 69, 0.96); color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
    <ui:VisualElement name="MoonEncyclopediaPanel" style="display: none; position: absolute; top: 84px; right: 16px; width: 400px; max-width: 90%; height: 460px; max-height: 60%; padding: 16px; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; background-color: rgba(20, 28, 39, 0.8); background-image: url(&quot;project://database/Assets/_2DAdventureGame/Animation/Cosmo/MoonEncyclopedia_Space.png?fileID=2800000&amp;guid=49f635da297c40a7b15e827ce4c169f1&amp;type=3#MoonEncyclopedia_Space&quot;); -unity-background-scale-mode: stretch-to-fill;">
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
            <ui:Label text="Енциклопедія Місяця" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; white-space: normal;"/>
            <ui:Button name="MoonEncyclopediaCloseButton" text="×" focusable="false" style="width: 42px; height: 42px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-color: rgba(245, 190, 91, 0.95); color: rgb(45, 35, 51); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:Label name="MoonEncyclopediaCounter" text="Вивчено: 0 із 5" style="margin-bottom: 10px; color: rgb(185, 211, 234); font-size: 16px; -unity-font-style: bold;"/>
        <ui:ScrollView name="MoonEncyclopediaFactList" mode="Vertical" style="flex-grow: 1; min-height: 0;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MobileControls" style="position: absolute; left: 16px; right: 16px; bottom: 16px; height: 200px;">
        <ui:Button name="MoveUp" text="▲" focusable="false" style="position: absolute; left: 64px; bottom: 128px; width: 60px; height: 60px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(39, 52, 70, 0.86); color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        <ui:Button name="MoveLeft" text="◀" focusable="false" style="position: absolute; left: 0; bottom: 64px; width: 60px; height: 60px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(39, 52, 70, 0.86); color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        <ui:Button name="MoveRight" text="▶" focusable="false" style="position: absolute; left: 128px; bottom: 64px; width: 60px; height: 60px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(39, 52, 70, 0.86); color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        <ui:Button name="MoveDown" text="▼" focusable="false" style="position: absolute; left: 64px; bottom: 0; width: 60px; height: 60px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(39, 52, 70, 0.86); color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
        <ui:Button name="ShootButton" focusable="false" tooltip="Стріляти" style="position: absolute; right: 0; bottom: 44px; width: 96px; height: 96px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; border-top-left-radius: 48px; border-top-right-radius: 48px; border-bottom-left-radius: 48px; border-bottom-right-radius: 48px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-color: rgb(255, 211, 135); border-right-color: rgb(255, 211, 135); border-bottom-color: rgb(255, 211, 135); border-left-color: rgb(255, 211, 135); background-color: rgba(220, 112, 49, 0.96); align-items: center; justify-content: center;">
            <ui:VisualElement name="AmmoIcon" style="width: 24px; height: 50px; flex-direction: column; justify-content: space-between; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(30, 40, 56); border-right-color: rgb(30, 40, 56); border-bottom-color: rgb(30, 40, 56); border-left-color: rgb(30, 40, 56); background-color: rgb(222, 232, 241);">
                <ui:VisualElement style="height: 14px; border-top-left-radius: 10px; border-top-right-radius: 10px; background-color: rgb(255, 210, 104);"/>
                <ui:VisualElement style="height: 5px; background-color: rgb(221, 144, 53);"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
    <ui:Button name="TalkButton" text="Поговорити" focusable="false" style="display: none; position: absolute; width: 210px; height: 68px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(67, 47, 62); border-right-color: rgb(67, 47, 62); border-bottom-color: rgb(67, 47, 62); border-left-color: rgb(67, 47, 62); background-color: rgb(245, 190, 91); color: rgb(45, 35, 51); font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
</ui:UXML>
